{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY"
  },
  "sources": {
    "rss": [
      {
        "name": "Yahoo Finance",
        "url": "https://yahoo.com",
        "profile": "tech-news"
      },
      {
        "name": "CNBC Top News",
        "url": "https://cnbc.com",
        "profile": "tech-news"
      }
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  }
}
