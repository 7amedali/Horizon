{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY"
  },
  "sources": {
    "reddit": [
      {
        "subreddit": "wallstreetbets",
        "limit": 15,
        "profile": "tech-news"
      },
      {
        "subreddit": "stocks",
        "limit": 15,
        "profile": "tech-news"
      },
      {
        "subreddit": "Daytrading",
        "limit": 10,
        "profile": "tech-news"
      },
      {
        "subreddit": "pennystocks",
        "limit": 10,
        "profile": "tech-news"
      }
    ],
    "google_news": [
      {
        "name": "Pre-Market High Volume Movers",
        "query": "premarket stock movers unusual volume today",
        "profile": "tech-news"
      },
      {
        "name": "Trending Stocks Twitter Reddit",
        "query": "most talked about stocks Reddit Twitter today",
        "profile": "tech-news"
      }
    ],
    "rss": [
      {
        "name": "Yahoo Finance Top Tickers",
        "url": "https://yahoo.com",
        "profile": "tech-news"
      }
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 4.0,
        "topic_dedup": true
      }
    }
  }
}
