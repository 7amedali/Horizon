{
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.0-flash",
    "api_key_env": "GOOGLE_API_KEY"
  },
  "sources": {
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "name": "wallstreetbets", "profile": "finance-news" },
        { "name": "stocks", "profile": "finance-news" },
        { "name": "Daytrading", "profile": "finance-news" },
        { "name": "pennystocks", "profile": "finance-news" }
      ]
    },
    "google_news": {
      "enabled": true,
      "queries": [
        { "query": "premarket stock movers unusual volume today", "profile": "finance-news" },
        { "query": "most talked about stocks Reddit Twitter today", "profile": "finance-news" }
      ]
    },
    "rss": [
      {
        "name": "Yahoo Finance Top Tickers",
        "url": "https://yahoo.com",
        "profile": "finance-news"
      }
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "finance-news",
    "profile_settings": {
      "finance-news": {
        "threshold": 4.0,
        "topic_dedup": true
      }
    }
  }
}
